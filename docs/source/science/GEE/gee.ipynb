   "source": [
    "rgb_img   = img.visualize(bands=[\"A00\",\"A01\",\"A02\"], min=[-1,-1,-1], max=[1,1,1])\n",
    "thumb_url = rgb_img.getThumbURL({\"region\": AOI, \"dimensions\": 1024, \"format\": \"png\"})\n",
    "\n",
    "# 2) Get AOI bounds for overlay (south, west, north, east)\n",
    "bbox = ee.Geometry(AOI).bounds().coordinates().getInfo()[0]\n",
    "# bbox is [[w,s], [e,s], [e,n], [w,n], [w,s]]\n",
    "west, south = bbox[0]\n",
    "east, north = bbox[2]\n",
    "bounds = [[south, west], [north, east]]\n",
    "\n",
    "\n",
    "center = [(south+north)/2, (west+east)/2]\n",
    "m = folium.Map(location=center, zoom_start=7, tiles=\"CartoDB positron\")\n",
    "\n",
    "\n",
    "folium.raster_layers.ImageOverlay(\n",
    "    image=thumb_url,\n",
    "    bounds=bounds,\n",
    "    opacity=0.9,\n",
    "    interactive=False,\n",
    "    cross_origin=False\n",
    ").add_to(m)\n",
    "\n",
    "\n",
    "m\n"
   ]
  }
